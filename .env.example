# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# If local MongoDB is not running, the system automatically falls back to an in-memory database store
MONGO_URI=mongodb://127.0.0.1:27017/hospital_management

# JSON Web Token Secret
JWT_SECRET=curahealth_super_secret_jwt_key_2026

# Optional: Force in-memory database mode for zero-configuration testing
# USE_MEMORY=true
