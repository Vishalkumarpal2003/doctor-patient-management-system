{
  "name": "doctor-patient-management-system",
  "version": "1.0.0",
  "description": "Complete MERN Stack Doctor Patient Management System",
  "scripts": {
    "build": "cd frontend && npm install --include=dev && npm run build",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "seed": "cd backend && npm run seed",
    "backend": "cd backend && npm start",
    "frontend": "cd frontend && npm run dev",
    "test": "node backend/tests/industryTest.js",
    "test:industry": "node backend/tests/industryTest.js",
    "test:api": "node backend/tests/apiTest.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "keywords": [
    "mern",
    "react",
    "nodejs",
    "express",
    "mongodb",
    "doctor-patient-management"
  ],
  "author": "CuraHealth",
  "license": "ISC"
}
